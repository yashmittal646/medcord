{
  "name": "async-health-backend",
  "version": "1.0.0",
  "description": "Patient-Controlled Longitudinal Medical Records & Controlled Doctor Access Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "build:client": "cd client && npm install --include=dev && npm run build",
    "render-build": "npm install --include=dev && npm run build && cd client && npm install --include=dev && npm run build",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/master_e2e.test.ts && tsx tests/access_control.test.ts && tsx tests/health_tracker.test.ts",
    "doctor:verify": "tsx src/scripts/verify-doctor.ts"
  },
  "keywords": [
    "healthcare",
    "medical-records",
    "health-paths",
    "audit-system"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
