# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/async_health

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_for_dev_async_health_2026
JWT_EXPIRES_IN=7d

# File Uploads & Cloud Storage
UPLOAD_STORAGE_TYPE=cloudinary # Options: cloudinary | local
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Doctor accounts start as PENDING and cannot open patient data until verified.
# There is no admin review screen yet, so this defaults to true outside production and false in production.
# Set to true to verify every new doctor automatically (demo deployments only).
# AUTO_VERIFY_DOCTORS=false

# AI features (optional). The health advisor and record auto-tagging use Groq first, Gemini second.
# Auto-tagging sends only a record's title/notes/tags (never the document itself) and falls back to a local
# keyword classifier when no key is set.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# DISABLE_AI_CLASSIFICATION=true   # keeps auto-tagging on the local keyword classifier only
